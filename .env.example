# Supabase project settings (Project Settings -> API)
# For Vercel: add these in Project Settings -> Environment Variables (Production, Preview, Development)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key_here

# Contact form (Web3Forms — https://web3forms.com, registered to info@drwaeldk.com)
# Optional override; a fallback key is bundled for production builds.
# After changing this on Vercel, redeploy the site so the build picks it up.
VITE_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here
